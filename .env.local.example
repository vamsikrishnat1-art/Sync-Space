# ==============================================================================
# SyncSpace Environment Configuration Example
# ==============================================================================
# Copy this template to .env.local for local overrides.
# NOTE: Do NOT commit .env.local or any sensitive credentials to git.
# ==============================================================================

# Public WebSocket URL for Yjs CRDT real-time collaboration.
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# If left unset, SyncSpace defaults automatically to: ws://localhost:1234
#
# PRODUCTION (e.g. Vercel deployment):
# Configure this in your Vercel Project Settings > Environment Variables.
# Point it to your hosted WebSocket server (Render, Railway, Fly.io, etc.):
# NEXT_PUBLIC_WS_URL=wss://syncspace-ws.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# WebSocket Server Configuration (server/ws-server.ts)
# ------------------------------------------------------------------------------
# PORT: Local fallback is 1234. In production container hosts, this is
# typically injected automatically by the platform (e.g., Render, Railway).
PORT=1234

# HOST: Network interface binding. Defaults to 0.0.0.0 to accept traffic
# from all container interfaces in production.
HOST=0.0.0.0
